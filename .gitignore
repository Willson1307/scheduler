__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 数据库文件不入库（含真实名单，必须留在本机）
data/
*.db
*.sqlite
*.sqlite3

# 演示用临时产物
.pytest_cache/
.coverage
htmlcov/

# 编辑器
.vscode/
.idea/
.DS_Store

# AI 工作区（自动化 memory 等，不入仓库）
.workbuddy/

# 运行期日志（调试/崩溃日志，不入库）
*.log

# ===========================================================================
# 🔴 密钥与本地环境（2026-11-10 补：AI 问答层要用 .env.local）
# ---------------------------------------------------------------------------
# 为什么必须有：项目的 LLM key 只从环境变量读，配置落在服务器 .env.local。
# 一旦这里漏了，某次 `git add -A` 就会把 key 提交上去 —— 而 git 历史删不干净，
# 组委会核查源代码时直接暴露。
# 规则：仓库里**只允许出现变量名**（SCHEDULER_LLM_KEY），绝不允许出现值。
# ===========================================================================
.env
.env.*
.env.local
*.key
*.pem
secrets/

# 本地 API key 放置目录（约定：D:\api-keys 之类的外部路径，禁止放进仓库）
api-keys/

# 交付报告（过程记录，不入库；内容已提炼进 docs/ 与任务卡）
# 为什么忽略：它记录的是「某次交付的现场细节」，随对话增长，且含大量临时路径/输出，
# 入库会让 clone 体积和 review 噪音都变大。要长期留存的结论请写进 docs/。
_交付报告-*.md
_审查报告-*.md
